<Window x:Class="DummyWPF.Search.wndSearch"
        Style="{StaticResource {x:Type Window}}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DummyWPF.Search"
        mc:Ignorable="d"
        Title="Search Window" Height="450" Width="800"
    xmlns:theme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero2">
    <Window.Resources>
        
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="dgSearchInvoice" Grid.Column="0" Padding="5 5 5 0"  d:ItemsSource="{d:SampleData ItemCount=20}" AutoGenerateColumns = "False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="InvoiceNo" Width="2*" Binding="{Binding InvoiceNum}"/>
                <DataGridTextColumn Header="Date" Width="3*" Binding="{Binding InvoiceDate}"/>
                <DataGridTextColumn Header="Total Charge" Width="2*" Binding="{Binding TotalCost}"/>
            </DataGrid.Columns>
        </DataGrid>
        <Canvas Grid.Column="1">
            <Grid HorizontalAlignment="Left" Height="22" Canvas.Left="10" Canvas.Top="36" VerticalAlignment="Center" Width="380">
                <ComboBox x:Name="cbSearchInvoiceNumber" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center" SelectionChanged="comboBoxes_SelectionChanged" />
                <ComboBox x:Name="cbSearchInvoiceDate" Width="120" HorizontalAlignment="Center" VerticalAlignment="Center" SelectionChanged="comboBoxes_SelectionChanged" />
                <ComboBox x:Name="cbSearchTotalCharge" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center" SelectionChanged="comboBoxes_SelectionChanged" Margin="260,0,0,0" />
            </Grid>
            <Button x:Name="btnSearchSelect" Content="Select" Canvas.Left="26" Canvas.Top="92" Height="44" Width="88" HorizontalAlignment="Center" VerticalAlignment="Center" Click="btnSearchSelect_Click" />
            <Button x:Name="btnSearchClear" Content="Clear" Canvas.Left="154" Canvas.Top="91" Height="46" Width="92" HorizontalAlignment="Left" VerticalAlignment="Top" Click="btnSearchClear_Click" />
            <Label Content="Invoice Number" Canvas.Left="23" Canvas.Top="10" HorizontalAlignment="Center" VerticalAlignment="Top"/>
            <Label Content="Invoice Date" Canvas.Left="162" Canvas.Top="10"/>
            <Label Content="Total Charge" Canvas.Left="292" Canvas.Top="10"/>

        </Canvas>


    </Grid>
</Window>
